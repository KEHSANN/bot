# Local development only; replace passwords before using any hosted environment.
VPNSTORE_ENVIRONMENT=development
POSTGRES_USER=vpnstore
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=vpnstore
VPNSTORE_DATABASE_URL=postgresql+asyncpg://vpnstore:local-development-only@127.0.0.1:5432/vpnstore
VPNSTORE_REDIS_URL=redis://127.0.0.1:6379/0
VPNSTORE_ALLOWED_HOSTS=["localhost","127.0.0.1"]
VPNSTORE_DEPENDENCY_TIMEOUT_SECONDS=2
VPNSTORE_DATABASE_POOL_SIZE=10
VPNSTORE_DATABASE_MAX_OVERFLOW=10

# Persisted price-quote lifetime, 60–3600 seconds.
VPNSTORE_QUOTE_SECONDS=900
