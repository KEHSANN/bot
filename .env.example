# ---- Telegram ----
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Comma separated Telegram numeric user IDs that bootstrap the owner role.
OWNER_TELEGRAM_IDS=111111111
# Public username of the bot (without @) used to build referral links.
BOT_USERNAME=my_vpn_bot

# ---- Database (PostgreSQL) ----
# Without Docker: point at your own server.
DATABASE_URL=postgresql+asyncpg://vpnbot:vpnbot_password@localhost:5432/vpnbot
# With docker compose: the db/bot/worker services build DATABASE_URL from these
# three values, so set them here and leave DATABASE_URL as-is.
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
POSTGRES_DB=vpnbot

# ---- Redis (optional; used for rate limiting / locks) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ---- Security ----
# 32 url-safe base64 characters key for Fernet encryption of VPN credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVENTORY_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# HMAC key for dedupe fingerprints. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
FINGERPRINT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# ---- Application ----
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8080
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081

# ---- Limits ----
MAX_IMPORT_FILE_BYTES=5242880
MAX_IMPORT_RECORDS=20000
WALLET_ENABLED=true
REFERRAL_ENABLED=true
REFERRAL_REWARD_IRT=20000
REFERRAL_TIER2_THRESHOLD=5
REFERRAL_TIER2_REWARD_IRT=10000
BROADCAST_RATE_PER_SECOND=20
PAYMENT_REVIEW_TTL_HOURS=48
