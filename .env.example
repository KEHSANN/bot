# Production-Grade Telegram VPN Store — Environment Configuration Template
# Copy to .env and replace all placeholders before starting in staging/production.
APP_ENV=development
CURRENCY=IRT
DATABASE_URL=postgresql+asyncpg://vpnstore:CHANGE_ME_DB_PASSWORD@postgres:5432/vpnstore
REDIS_URL=redis://redis:6379/0
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_BYTES_CRYPTOGRAPHIC_SECRET
ENCRYPTION_MASTER_KEY=REPLACE_WITH_AT_LEAST_32_BYTES_MASTER_ENCRYPTION_KEY
TELEGRAM_BOT_TOKEN=0000000000:REPLACE_WITH_REAL_BOTFATHER_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET_TOKEN
ALLOW_FAKE_PROVIDERS=false
MEMBERSHIP_CACHE_TTL_SECONDS=86400
QUOTE_TTL_SECONDS=900
